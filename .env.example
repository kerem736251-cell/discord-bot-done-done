# Keep all existing Discord/channel/role/API settings.
DISCORD_TOKEN=
DB_PATH=/data/quantix.db
# Use keys from the corresponding Quantix Pro/Elite License Manager. Paste PEM with real line breaks
# or escaped \n. Do not commit private keys or replace these with new keys.
QUANTIX_PRO_PRIVATE_KEY_PEM=
QUANTIX_ELITE_PRIVATE_KEY_PEM=
# Local alternative: set *_PRIVATE_KEY_FILE to the existing private PEM path.
